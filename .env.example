# ── Odoo Connection ────────────────────────────────────────────────────────────
# Local dev: leave blank (proxy in package.json forwards to localhost:8069)
# Odoo.sh:   set to your instance URL  e.g. https://mycompany.odoo.com
REACT_APP_ODOO_BASE_URL=

# ── App ────────────────────────────────────────────────────────────────────────
REACT_APP_APP_NAME=Odoo Deploy Test
REACT_APP_ENV=development

# ── Odoo.sh build output path (used by npm run build:odoo) ────────────────────
# BUILD_PATH is set inline in the npm script; you don't need to change this.
